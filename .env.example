# ==========================================
# GIANT: Environment Configuration Template
# Copy this file to .env and populate values.
# ==========================================

# Server Settings
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database Connection (Default: local SQLite database; for PostgreSQL provide connection URL)
DATABASE_URL=sqlite:///./giant.db
# DATABASE_URL=postgresql://giant_admin:giant_secure_password@localhost:5432/giant_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Scheduler Intervals
BREAKING_NEWS_INTERVAL_MINUTES=5
GENERAL_NEWS_INTERVAL_MINUTES=15
OFFICIAL_STATS_CHECK_HOURS=24

# AI Analyst (Optional - If unset, grounded deterministic RAG summaries are generated)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_SPEND_CAP_USD=10.0

# Microsoft Power BI Service Embedding (Optional - If unset, setup guide & fallback dashboard render)
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=

# Giant Backend Configuration Environment Variables

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL URL e.g. postgresql://user:password@localhost:5432/giant)
# If empty or omitted, defaults to SQLite for local development: sqlite:///./giant.db
DATABASE_URL=sqlite:///./giant.db

# Ingestion & Polling intervals (minutes)
BREAKING_NEWS_INTERVAL_MINUTES=5
GENERAL_NEWS_INTERVAL_MINUTES=15
OFFICIAL_STATS_CHECK_HOURS=24

# AI / LLM Configuration (Optional for Milestone 1, utilized in Milestone 3)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_SPEND_CAP_USD=10.0

# Microsoft Power BI Configuration (Used in Milestone 5)
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
